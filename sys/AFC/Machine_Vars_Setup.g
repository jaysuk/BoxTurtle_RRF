;    ; was main_extruder

; ########## Start Print ###########

global Gcode_bed_temp = 0                   ; This is used to store the bed temperature from the gcode
; was slicerBedTemp
global Gcode_bed_temp_override = 0           ; This value should be set to something different to override the value from the gcode
; was slicerBedTempOverride
global Gcode_hotend_temp = 0                ; This is used to store the hotend temperature from the gcode
; was slicerHotendTemp
global Gcode_hotend_temp_override = 0        ; This value should be set to something different to override the value from the gcode
; was slicerHotendTempOverride
global Machine_soak_time_override = false            ; This allows the soak time to be overridden
; was soakTimeOverride
global Machine_override_bed_off = false              ; This allows turning off of the bed to be overridden
; was overrideBedOff
global Machine_override_hotend_off = false           ; This allows turning off of the hotend to be overridden
