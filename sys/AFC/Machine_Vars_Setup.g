;    var e_a = move.extruders[tools[global.tool_and_motion[iterations][0]].extruders[0]].acceleration
;    var e_c = move.extruders[tools[global.tool_and_motion[iterations][0]].extruders[0]].current

;    ; This is the information about the extruder currently installed in your machine
