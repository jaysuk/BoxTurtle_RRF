; ==========================================================================================
; Spool - Unassign
; Unassigns the currently loaded spool from a specific lane.
; ==========================================================================================

var unit_number = 0
var lane_number = 0

var is_silent = false

; 1. Check for parameters (Silent execution by other macros)
if exists(param.A) && exists(param.B)
    set var.unit_number = param.A
    set var.lane_number = param.B
    set var.is_silent = true
else
    ; 1b. Interactive Select Unit
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
        if input == -1
            abort
        set var.unit_number = input
    else
        set var.unit_number = 0

    ; 2b. Interactive Select Lane
    M291 P"Select the lane to unassign the spool from" K{global.M291_data[1][var.unit_number]} S4 J1
    if input == -1
        abort
    set var.lane_number = input

; Check if a spool is actually assigned
if global.spool_active_data[var.unit_number][var.lane_number][0] == -1
    ;M291 P{"Unit " ^ var.unit_number ^ " Lane " ^ var.lane_number ^ " does not have a spool assigned."} R"Nothing to do" S1 T3
else
    ; 3. Confirm Unassign (Only if interactive)
    var current_spool = global.spool_active_data[var.unit_number][var.lane_number][0]
    if !var.is_silent
        M291 P{"Are you sure you want to unassign Spool " ^ var.current_spool ^ " from Unit " ^ var.unit_number ^ " Lane " ^ var.lane_number ^ "?"} R"Confirm Unassign" S3

    ; 4. Clear data
    set global.spool_active_data[var.unit_number][var.lane_number] = {-1, "", "", "", 0.0, 0.0, "", "", ""}
    set global.AFC_lanes[var.unit_number][var.lane_number][4] = {"None", "None"}
    set global.spoolman[var.unit_number][var.lane_number] = {-1, global.spoolman[var.unit_number][var.lane_number][1]}

    M98 P"0:/sys/AFC/Macros/save_status.g"

    if !var.is_silent
        M291 P{"Spool unassigned from Unit " ^ var.unit_number ^ " Lane " ^ var.lane_number ^ " successfully."} R"Success" S1 T3
