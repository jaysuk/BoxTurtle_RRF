; ==========================================================================================
; AFC LED Test Macro
; Uses the same code as the real LEDs (AFC_LED_array + leds.g), so what you see is exactly what the system will show:
; multi-port strips, lane reversal and brightness included. The LED state is restored afterwards.
; ==========================================================================================

var unit_number = 0
var test_mode = 0 ; 0 = selected lane cycles the status colours, 1 = all lanes cycle, 2 = one lane after the other, 3 = every lane in every colour
var lane_number = 0
var phase = 0
var num_phases = 7 ; status codes 0-6: red, green, blue, white, yellow, magenta, cyan
var l = 0
var saved = global.AFC_LED_array[0]                                     ; copy of the unit's LED state (replaced below)

; --- User Input: Select Unit ---
if #global.M291_data[0] != 1
    M291 P"Select the Unit" K{global.M291_data[0]} S4 J2
    if result == -1
        M99
    set var.unit_number = input

; --- User Input: Select Test Mode ---
M291 P"Select Test Mode" K{"Cycle Colors (Selected)","Cycle Colors (All)","Sequence Lanes (One-by-One)","Sequence Colors per Lane"} S4 J2
if result == -1
    M99
set var.test_mode = input

if var.test_mode == 0
    M291 P"Select the lane to test" K{global.M291_data[1][var.unit_number]} S4 J2
    if result == -1
        M99
    set var.lane_number = input

set var.saved = global.AFC_LED_array[var.unit_number]
M291 P"Starting LED Test Sequence..." R"Testing" S1 T2

; --- Mode 0 / 1: every status colour on the selected lane / on all lanes ---
if var.test_mode == 0 || var.test_mode == 1
    while iterations < var.num_phases
        set var.phase = iterations
        while iterations < global.AFC_unit_total_lanes[var.unit_number]
            if var.test_mode == 1 || iterations == var.lane_number
                set global.AFC_LED_array[var.unit_number][iterations] = var.phase
        M98 P"0:/sys/AFC/Macros/leds.g"
        G4 S1

; --- Mode 2: white on one lane at a time (shows the lane order along the strip) ---
elif var.test_mode == 2
    while iterations < global.AFC_unit_total_lanes[var.unit_number]
        set var.l = iterations
        while iterations < global.AFC_unit_total_lanes[var.unit_number]
            set global.AFC_LED_array[var.unit_number][iterations] = 9      ; off
        set global.AFC_LED_array[var.unit_number][var.l] = 3
        M98 P"0:/sys/AFC/Macros/leds.g"
        G4 S1

; --- Mode 3: every lane in every colour, one lane after the other ---
elif var.test_mode == 3
    while iterations < global.AFC_unit_total_lanes[var.unit_number]
        set var.l = iterations
        while iterations < var.num_phases
            set global.AFC_LED_array[var.unit_number][var.l] = iterations
            M98 P"0:/sys/AFC/Macros/leds.g"
            G4 S1
        set global.AFC_LED_array[var.unit_number][var.l] = 9

; --- Restore ---
set global.AFC_LED_array[var.unit_number] = var.saved
M98 P"0:/sys/AFC/Macros/leds.g"
M291 P"Test Complete. LED state restored." R"Done" S1 T2
