; ==========================================================================================
; AFC Lane Length Measurement (Sensor-Based)
; 1. Homes Reverse to the Load Switch (Start).
; 2. Measures Forward to the Hub Switch (End), backs off hub_retract_distance and stores that as the first length.
; Failures call afc_error.g (the 'f axis, endstops, DC motor and Longboi triggers are cleaned up).
; ==========================================================================================

; --- Configuration & Variables ---
var lane_number = 0
var tool_number = 0
var unit_number = 0
var safety_dist = 300          ; Max distance to search (must be longer than longest tube)
var msg_time = 3                ; Message duration

; --- Determine Lane Number ---
if exists(param.A)
    set var.tool_number = param.A                                              ; Assign parameter to local variable for cleaner syntax
    set var.unit_number = global.Tool_to_AFC[var.tool_number][0]
    set var.lane_number = global.Tool_to_AFC[var.tool_number][1]
else
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
        set var.unit_number = input
    else
        set var.unit_number = 0

    M291 P"Select the lane to measure" K{global.M291_data[1][var.unit_number]} S4 J1
    set var.lane_number = input
    set var.tool_number = global.AFC_lane_to_tool[var.unit_number][var.lane_number]

; --- Pre-Flight Check ---
if !global.AFC_lanes[var.unit_number][var.lane_number][0]
    M291 P{"Error: Unit "^var.unit_number^": Lane " ^ var.lane_number ^ " is not marked as Loaded. Aborting."} R"Calibration Failed" S2
    M99

; ==========================================================================================
; Setup
; ==========================================================================================
M291 P{"Calibrating Unit "^var.unit_number^": Lane " ^ var.lane_number ^ "..."} R"System Busy" S0 T{var.msg_time}

; Maps the lane motor to 'f, unhides it and (Longboi) disarms the lane triggers
M98 P"0:/sys/AFC/Macros/lane_motion_begin.g" A{var.tool_number}

; ==========================================================================================
; Step 1: Find Start Position (Home to Load Switch)
; ==========================================================================================
M291 P"Homing to Load Switch..." R"Step 1/2" S0 T{var.msg_time}

; 1. Enable DC Motor (Reverse)
if global.AFC_features[var.unit_number][0]
    M98 P"0:/sys/AFC/Macros/dc_motors.g" A"R" B{var.tool_number}
    M400

; 2. Configure Load Switch as Low Endstop (Min). The inverted switch triggers when the filament leaves it.
M574 'f1 S1 P{"!"^global.AFC_load_switch[var.unit_number][var.lane_number]}

; 3. Set a temporary position so the printer thinks it has room to rewind
; We add 200mm to the known length just in case the software count was off.
if global.AFC_lanes[var.unit_number][var.lane_number][1] > 0
    G92 'f{global.AFC_lanes[var.unit_number][var.lane_number][1] + 200}
else
    G92 'f{var.safety_dist}

; 4. Home Backwards (The "Unload" move)
; This pulls the filament back until the Load Switch triggers.
G1 H4 'f0 F{global.AFC_load_retract_speed[var.unit_number][1]*60}
M400

; Turn off DC Motor while we switch direction
if global.AFC_features[var.unit_number][0]
    M98 P"0:/sys/AFC/Macros/dc_motors.g" A"O" B{var.tool_number}

if !sensors.endstops[global.AFC_f_axis].triggered
    M98 P"0:/sys/AFC/Macros/afc_error.g" S{"Unit "^var.unit_number^" Lane "^var.lane_number^": the load switch was not found while homing backwards. Check the filament and the switch"} T{var.tool_number}
    M99

; 5. Set True Zero
; We are now exactly at the Load Switch. Set this as 0.
G92 'f0

; ==========================================================================================
; Step 2: Measure to Hub Switch
; ==========================================================================================
M291 P"Measuring to Hub Switch..." R"Step 2/2" S0 T{var.msg_time}

; 1. Configure Hub Switch as High Endstop (Max). Binding it replaces the load switch endstop (one endstop per axis).
M574 'f2 S1 P{global.AFC_hub_switch[var.unit_number]}

; 2. Measure Forward
; Moves forward until Hub Switch triggers. H4 updates the machine position.
G1 H4 'f{var.safety_dist} F{global.AFC_load_retract_speed[var.unit_number][0]*60}
M400

; 3. The hub switch must have triggered BEFORE the maximum distance was reached
if !sensors.endstops[global.AFC_f_axis].triggered || move.axes[global.AFC_f_axis].machinePosition >= var.safety_dist - 0.5
    M98 P"0:/sys/AFC/Macros/afc_error.g" S{"Unit "^var.unit_number^" Lane "^var.lane_number^": the hub switch was not reached within "^var.safety_dist^"mm, so the measurement would be wrong. Please investigate"} T{var.tool_number}
    M99

G91                                                                                                                   ; This sets the system into relative mode.
G1 'f{-global.AFC_hub_retract_distance[var.unit_number]} F{global.AFC_load_retract_speed[var.unit_number][1]*60}      ; This retracts the filament by a set amount so it's no longer triggering the hub switch.
G90                                                                                                                   ; This sets the system back into absolute mode.
M400                                                                                                                  ; This waits for all movement to stop.

; 4. Capture Measurement
set global.AFC_lanes[var.unit_number][var.lane_number][1] = move.axes[global.AFC_f_axis].machinePosition

; ==========================================================================================
; Step 3: Save and clean up
; ==========================================================================================
M291 P"Saving..." R"Finishing" S0 T{var.msg_time}

; Save to File
M98 P"0:/sys/AFC/Macros/save_status.g"

; Free the endstop, hide 'f and re-arm the Longboi triggers
M98 P"0:/sys/AFC/Macros/lane_motion_end.g" A{var.tool_number}

; Final Report
M291 P{"Calibration Complete. Unit "^var.unit_number^": Lane " ^ var.lane_number ^ " Length: " ^ global.AFC_lanes[var.unit_number][var.lane_number][1] ^ "mm"} R"Success" S1
