; ==========================================================================================
; AFC System Length Calibration
; Measures distance from the lane park position (first length) to the toolhead sensor and updates ALL lanes of the unit
; ([2] = [1] + measured length). With load method 1 (lengths) the length can also be typed in.
; Failures call afc_error.g (the 'f axis, endstops, DC motor and Longboi triggers are cleaned up).
; ==========================================================================================

; --- Configuration ---
var msg_time = 3            ; Seconds to show status messages
var search_dist = 5000      ; Longest hub-to-toolhead distance the search move may travel (mm)

; --- Variables ---
var lane_number = 0
var tool_number = 0
var unit_number = 0
var first_length = 0
var additional_length = 0
var total_length = 0
var manual = false          ; true = the length is typed in instead of measured

; ==========================================================================================
; 1. Safety Checks & Selection
; ==========================================================================================

; User Selection
if exists(param.A)
    set var.tool_number = param.A                                              ; Assign parameter to local variable for cleaner syntax
    set var.unit_number = global.Tool_to_AFC[var.tool_number][0]
    set var.lane_number = global.Tool_to_AFC[var.tool_number][1]
else
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
        set var.unit_number = input
    else
        set var.unit_number = 0

    M291 P"Select the lane to use to measure the main length" K{global.M291_data[1][var.unit_number]} S4 J1
    set var.lane_number = input
    set var.tool_number = global.AFC_lane_to_tool[var.unit_number][var.lane_number]

; Load method 2 needs the extruder input switch, load method 1 can do without any switch
if global.AFC_features[var.unit_number][2] == 2 && global.Machine_extruder_switches[0] == "nil"
    M291 P"Load method 2 needs Machine_extruder_switches[0] (the extruder input switch) to be configured." R"Aborted" S2
    M99
if global.AFC_features[var.unit_number][2] == 1
    M291 P"Load method 1 (lengths) does not need a switch. Measure with the TN switch, or type the length in?" R"Main length" K{"Measure", "Enter manually"} S4 J2
    if result == -1                                                            ; cancelled
        M99
    if input == 1
        set var.manual = true

; Check Hub Switch (Ensure path isn't physically blocked before starting)
M950 J{global.AFC_hub_input_numbers[var.unit_number]} C{global.AFC_hub_switch[var.unit_number]}
if sensors.gpIn[global.AFC_hub_input_numbers[var.unit_number]].value != 0
    M950 J{global.AFC_hub_input_numbers[var.unit_number]} C"nil"
    M291 P{"Error: Filament detected in Unit "^var.unit_number^" Hub Switch! Clear path before measuring."} R"Aborted" S2
    M99
M950 J{global.AFC_hub_input_numbers[var.unit_number]} C"nil"

; Check if Selected Lane is actually loaded (Prevents grinding/air printing)
if !global.AFC_lanes[var.unit_number][var.lane_number][0]
    M291 P{"Error: Unit "^var.unit_number^": Lane " ^ var.lane_number ^ " is not marked as Loaded. Cannot Measure."} R"Aborted" S2
    M99

; Retrieve known start length
set var.first_length = global.AFC_lanes[var.unit_number][var.lane_number][1]

; ==========================================================================================
; 2. Measurement Routine
; ==========================================================================================
if var.manual
    M291 P"Enter the distance in mm from the lane park position to the toolhead sensor" R"Main length" S6 J2
    if result == -1                                                            ; cancelled
        M99
    set var.additional_length = input
    if var.additional_length <= 0
        M291 P"The length must be greater than 0." R"Aborted" S2
        M99
else
    M291 P{"Preparing Unit "^var.unit_number^": Lane " ^ var.lane_number ^ "..."} R"System Busy" S0 T{var.msg_time}
    M98 P"0:/sys/AFC/Macros/lane_motion_begin.g" A{var.tool_number}            ; Map the lane motor to 'f, unhide it, disarm Longboi triggers

    ; --- Case A: TN Switch (load methods 0 and 1) ---
    if global.AFC_features[var.unit_number][2] == 0 || global.AFC_features[var.unit_number][2] == 1
        M291 P"Searching for TN Switch..." R"Step 1/3" S0 T{var.msg_time}
        M574 'f2 S1 P{global.AFC_TN_switches[var.unit_number][0]}
        M400
        G92 'f{var.first_length}
        M400

        ; Probe for switch (bounded)
        G1 H4 'f{var.first_length + var.search_dist} F{global.AFC_load_retract_speed[var.unit_number][0]*60}
        M400
        if !sensors.endstops[global.AFC_f_axis].triggered
            M98 P"0:/sys/AFC/Macros/afc_error.g" S{"The TN switch of Unit "^var.unit_number^" was not reached within "^var.search_dist^"mm"} T{var.tool_number}
            M99

        ; Back off to park position
        G91
        G1 H2 'f{-global.AFC_tn_retract_distance[var.unit_number]} F{global.AFC_load_retract_speed[var.unit_number][1]*60}
        G90
        M400

    ; --- Case B: Extruder Switch (load method 2) ---
    else
        M291 P"Searching for Extruder Switch..." R"Step 1/3" S0 T{var.msg_time}
        M574 'f2 P{global.Machine_extruder_switches[0]} S1
        M400
        G92 'f{var.first_length}
        M400

        ; Probe for switch (bounded)
        G1 H4 'f{var.first_length + var.search_dist} F{global.AFC_load_retract_speed[var.unit_number][0]*60}
        M400
        if !sensors.endstops[global.AFC_f_axis].triggered
            M98 P"0:/sys/AFC/Macros/afc_error.g" S{"The extruder input switch was not reached within "^var.search_dist^"mm"} T{var.tool_number}
            M99

    ; Calculate the "Hub to Sensor" distance (This is constant for all lanes)
    M291 P"Calculating and Saving Data..." R"Step 2/3" S0 T{var.msg_time}
    set var.total_length = move.axes[global.AFC_f_axis].machinePosition
    set var.additional_length = var.total_length - var.first_length

; ==========================================================================================
; 3. Persistence: update ALL lanes of the unit
; ==========================================================================================
; (Uses a loop so it works for 4, 6, or 12 lanes automatically)
while iterations < global.AFC_unit_total_lanes[var.unit_number]
    set global.AFC_lanes[var.unit_number][iterations][2] = global.AFC_lanes[var.unit_number][iterations][1] + var.additional_length

; Save to File
M98 P"0:/sys/AFC/Macros/save_status.g"

; ==========================================================================================
; 4. Retraction & Cleanup
; ==========================================================================================
if !var.manual
    M291 P"Retracting Filament..." R"Step 3/3" S0 T{var.msg_time}

    ; Activate DC Motor (Assist)
    if global.AFC_features[var.unit_number][0]
        M98 P"0:/sys/AFC/Macros/dc_motors.g" A"R" B{var.tool_number}
        M400

    ; Retract Step
    G1 'f{var.first_length} F{global.AFC_load_retract_speed[var.unit_number][1]*60}
    M400

    ; Stop DC Motor
    if global.AFC_features[var.unit_number][0]
        M98 P"0:/sys/AFC/Macros/dc_motors.g" A"O" B{var.tool_number}
        M400

    ; Free the endstop, hide 'f and re-arm the Longboi triggers
    M98 P"0:/sys/AFC/Macros/lane_motion_end.g" A{var.tool_number}

; Final Report
M291 P{"Calibration Complete. Added Length (Hub->Sensor): " ^ var.additional_length ^ "mm"} R"Success" S1
if #global.M291_data[0] != 1
    M291 P"Remember to do this for your other AFC units" R"Reminder" S1
