; ############## Auto-Setup: File Generator #############
; This script automatically generates the necessary system files (tpre, tpost, triggers, etc.)
; based on the user's AFC configuration. It allows the user to select specific files or generate all at once.

var filename = " " ; Variable to store the name of the file currently being created
var choice=0       ; Variable to store the user's menu selection
var unit_number = 0
var lane_number = 0
var msg_time = 3

; --- User Menu ---
; Prompt the user to select which group of files to generate.
; Options range from "All" (0) to specific categories like Triggers (4) or cleanup (7).
M291 P"Select the files to be created" K{"All","tpre","tpost","tfree","Triggers","Homing File","Filament Errors","Rename Unused Files"} S4 J1
set var.choice=input

; --- 1. Generate tpre.g (Tool Pre-Change) ---
if var.choice == 0 || var.choice == 1
    set var.filename = "tpre.g"
    echo >{var.filename} "; autogenerated tpre.g file" ; Create/Overwrite file
    ; Write command to call the central AFC tpre macro, passing the *next* tool index
    echo >>{var.filename} "M98 P""0:/sys/AFC/Macros/tpre.g"" A{move.motionSystems[0].nextTool}"
    if var.choice == 1
        M291 P{"The tpre.g file has been created"} R"Success" S1 T{var.msg_time}

; --- 2. Generate tpost.g (Tool Post-Change) ---
if var.choice == 0 || var.choice == 2
    set var.filename = "tpost.g"
    echo >{var.filename} "; autogenerated tpost.g file" ; Create/Overwrite file
    ; Write command to call the central AFC tpost macro, passing the *current* tool index
    echo >>{var.filename} "M98 P""0:/sys/AFC/Macros/tpost.g"" A{move.motionSystems[0].currentTool}"
    if var.choice == 2
        M291 P{"The tpost.g file has been created"} R"Success" S1 T{var.msg_time}

; --- 3. Generate tfree.g (Tool Free/Unload) ---
if var.choice == 0 || var.choice == 3
    set var.filename = "tfree.g"
    echo >{var.filename} "; autogenerated tfree.g file" ; Create/Overwrite file
    ; Write logic to check if DC motor feature is enabled
    ; tfree only runs while a tool is current, so resolve the unit from that tool when the generated file runs
    echo >>{var.filename} "if global.AFC_features[global.AFC_tool_map[move.motionSystems[0].currentTool][0]][0]"
    ; If enabled, call tfree with B1 (DC Motor On)
    echo >>{var.filename} "    M98 P""0:/sys/AFC/Macros/tfree.g"" A{move.motionSystems[0].currentTool} B1"
    echo >>{var.filename} "else"
    ; If disabled, call tfree with B0 (DC Motor Off)
    echo >>{var.filename} "    M98 P""0:/sys/AFC/Macros/tfree.g"" A{move.motionSystems[0].currentTool} B0"
    echo >>{var.filename} "M400"
    if var.choice == 3
        M291 P{"The tfree.g file has been created"} R"Success" S1 T{var.msg_time}

; --- 4. Generate Trigger Files ---
if var.choice == 0 || var.choice == 4
    ; Loop through all lanes to create basic trigger files (e.g., for filament runout/presence)
    while iterations < #global.AFC_unit_CAN_ids
        set var.unit_number = iterations
        while iterations < global.AFC_unit_total_lanes[var.unit_number]
            set var.lane_number = iterations
            set var.filename = "trigger"^{global.AFC_trigger_numbers[var.unit_number][var.lane_number]}^".g"
            echo >{var.filename} "; autogenerated trigger"^global.AFC_trigger_numbers[var.unit_number][var.lane_number]^".g file"
            echo >>{var.filename} "if !global.AFC_lanes["^var.unit_number^"]["^var.lane_number^"][0]"
            echo >>{var.filename} "    M98 P""0:/sys/AFC/Macros/triggers.g"" A"^global.AFC_lane_to_tool[var.unit_number][var.lane_number]

    ; --- Buffer Triggers ---
    ; tpost arms each buffer input on BOTH edges (M581 S1 + S0 on the same trigger), so the generated file checks the input:
    ;   advance switch active (too much filament in the bowden) -> feed 5% less from the lane (x0.95)
    ;   trailing switch active (too little filament)            -> feed 5% more from the lane (x1.05)
    ;   switch released                                         -> back to 1:1
    ; The file acts on whatever tool is current now, if that tool draws from this unit (tool->lane map), through buffer_mix.g.
    while iterations < #global.AFC_unit_CAN_ids
        set var.unit_number = iterations
        set var.filename = "trigger"^{global.AFC_buffer_trigger_numbers[var.unit_number][0]}^".g"
        echo >{var.filename} "; autogenerated trigger"^global.AFC_buffer_trigger_numbers[var.unit_number][0]^".g file (advance buffer switch of unit "^var.unit_number^")"
        echo >>{var.filename} "; Fires on both edges once a print has been initiated: the mix is 0.95 while the switch is active and 1.0 otherwise"
        echo >>{var.filename} "if move.motionSystems[0].currentTool >= 0 && move.motionSystems[0].currentTool < #global.AFC_tool_map"
        echo >>{var.filename} "    if global.AFC_tool_map[move.motionSystems[0].currentTool][0] == "^var.unit_number
        echo >>{var.filename} "        if sensors.gpIn["^global.AFC_buffer_input_numbers[var.unit_number][0]^"].value == 1"
        echo >>{var.filename} "            M98 P""0:/sys/AFC/Macros/buffer_mix.g"" A{move.motionSystems[0].currentTool} B0.95"
        echo >>{var.filename} "        else"
        echo >>{var.filename} "            M98 P""0:/sys/AFC/Macros/buffer_mix.g"" A{move.motionSystems[0].currentTool} B1"

        set var.filename = "trigger"^{global.AFC_buffer_trigger_numbers[var.unit_number][1]}^".g"
        echo >{var.filename} "; autogenerated trigger"^global.AFC_buffer_trigger_numbers[var.unit_number][1]^".g file (trailing buffer switch of unit "^var.unit_number^")"
        echo >>{var.filename} "; Fires on both edges once a print has been initiated: the mix is 1.05 while the switch is active and 1.0 otherwise"
        echo >>{var.filename} "if move.motionSystems[0].currentTool >= 0 && move.motionSystems[0].currentTool < #global.AFC_tool_map"
        echo >>{var.filename} "    if global.AFC_tool_map[move.motionSystems[0].currentTool][0] == "^var.unit_number
        echo >>{var.filename} "        if sensors.gpIn["^global.AFC_buffer_input_numbers[var.unit_number][1]^"].value == 1"
        echo >>{var.filename} "            M98 P""0:/sys/AFC/Macros/buffer_mix.g"" A{move.motionSystems[0].currentTool} B1.05"
        echo >>{var.filename} "        else"
        echo >>{var.filename} "            M98 P""0:/sys/AFC/Macros/buffer_mix.g"" A{move.motionSystems[0].currentTool} B1"
    ; --- Buffer fault trigger (both buffer switches active = jam or wiring fault): pause the print ---
    while iterations < #global.AFC_unit_CAN_ids
        set var.unit_number = iterations
        set var.filename = "trigger"^{global.AFC_buffer_fault_triggers[var.unit_number]}^".g"
        echo >{var.filename} "; autogenerated trigger"^global.AFC_buffer_fault_triggers[var.unit_number]^".g file (both buffer switches of unit "^var.unit_number^" are active)"
        echo >>{var.filename} "M98 P""0:/sys/AFC/Macros/afc_error.g"" S""Both buffer switches of unit "^var.unit_number^" are active. Check the TurtleNeck for a jam and its wiring"" Q1"
    ; --- Low-spool warning trigger (fires once when the current spool drops below Machine_low_spool) ---
    set var.filename = "trigger"^{global.AFC_lowspool_trigger}^".g"
    echo >{var.filename} "; autogenerated trigger"^global.AFC_lowspool_trigger^".g file (current spool is running low)"
    echo >>{var.filename} "M118 S""AFC: the spool on the current lane is running low"""
    echo >>{var.filename} "M98 P""0:/sys/AFC/Macros/afc_log.g"" S{""Spool running low: ""^global.AFC_spool_left^"" mm left""}"
    echo >>{var.filename} "M291 P""The spool on the current lane is running low. Have a replacement ready."" R""Low spool"" S1 T10"
    if var.choice == 4
        M291 P{"The trigger files have been created"} R"Success" S1 T{var.msg_time}

; --- 5. Generate Homing File ---
if var.choice == 0 || var.choice == 5
    ; Note: ''f escapes the single quote to create axis 'f' in the output file
    echo >"home''f.g" "; autogenerated home''f.g file"
    echo >>"home''f.g" "G92 ''f0" ; Write position reset
    if var.choice == 5
        M291 P{"The homing file has been created"} R"Success" S1 T{var.msg_time}

; --- 6. Generate Filament Error File ---
; RRF (3.4+) runs exactly 0:/sys/filament-error.g for a filament monitor event (no extruder number in the name).
; It does NOT pause by itself when this file exists - the AFC handler pauses the print first.
if var.choice == 0 || var.choice == 6
    set var.filename = "filament-error.g"
    echo >{var.filename} "; autogenerated filament-error.g file"
    echo >>{var.filename} "M98 P""0:/sys/AFC/Macros/filament-error.g"" D{param.D} B{param.B}"
    if var.choice == 6
        M291 P{"The filament error file has been created"} R"Success" S1 T{var.msg_time}

; --- 7. Rename/Backup Unused Files ---
; This prevents conflicts between specific tool files (like tpre0.g) and the generic generated files (tpre.g)
if var.choice == 0 || var.choice == 7
    if fileexists("0:/sys/tpre0.g")
        M471 S"0:/sys/tpre0.g" T"0:/sys/tpre0.unused" ; Rename tpre0.g -> tpre0.unused
    if fileexists("0:/sys/tpost0.g")
        M471 S"0:/sys/tpost0.g" T"0:/sys/tpost0.unused" ; Rename tpost0.g -> tpost0.unused
    if fileexists("0:/sys/tfree0.g")
        M471 S"0:/sys/tfree0.g" T"0:/sys/tfree0.unused" ; Rename tfree0.g -> tfree0.unused
    if var.choice == 7
        M291 P{"The old toolchange files have been renamed"} R"Success" S1 T{var.msg_time}

if var.choice == 0
    ; The 0:/spools folder is created by the first spool file that is written
    M291 P{"All files required have been created in the sys folder"} R"Success" S1 T{var.msg_time}
