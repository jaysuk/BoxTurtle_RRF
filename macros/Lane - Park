; ==========================================================================================
; Lane - Park
; Feeds the filament of a lane to its park position, exactly like inserting it does: it is pushed to the load switch, the lane
; is marked loaded and then moved to the measured first length. Use it after handling filament by hand ("re-park"), or choose
; All to park every lane whose prep switch sees filament ("load all lanes").
; Lanes without filament at the prep switch and the lane the current tool draws from are skipped.
; param.A tool number of one lane (no menus)
; ==========================================================================================

var unit_number = 0
var lane_number = 0
var tool_number = 0
var is_all = false
var parked = 0

if exists(param.A)
    set var.tool_number = param.A
    set var.unit_number = global.Tool_to_AFC[var.tool_number][0]
    set var.lane_number = global.Tool_to_AFC[var.tool_number][1]
else
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J2
        if result == -1
            M99
        set var.unit_number = input
    M291 P"Select the lane to park" K{global.M291_data[2][var.unit_number]} S4 J2
    if result == -1
        M99
    if input == global.AFC_unit_total_lanes[var.unit_number]
        set var.is_all = true
    else
        set var.lane_number = input
    if !var.is_all
        set var.tool_number = global.AFC_lane_to_tool[var.unit_number][var.lane_number]

if move.motionSystems[0].currentTool >= 0 && move.motionSystems[0].currentTool < #global.AFC_tool_map
    if !var.is_all && global.AFC_tool_map[move.motionSystems[0].currentTool][0] == var.unit_number && global.AFC_tool_map[move.motionSystems[0].currentTool][1] == var.lane_number
        M291 P"That lane is loaded in the toolhead. Select T-1 first." R"Lane - Park" S2
        M99

if !var.is_all
    if sensors.gpIn[global.AFC_trigger_input_numbers[var.unit_number][var.lane_number]].value != 1
        M291 P"No filament at the prep switch of that lane." R"Lane - Park" S2
        M99
    M98 P"0:/sys/AFC/Macros/triggers.g" A{var.tool_number}
    M99

; --- All lanes of the unit ---
while iterations < global.AFC_unit_total_lanes[var.unit_number]
    set var.lane_number = iterations
    set var.tool_number = global.AFC_lane_to_tool[var.unit_number][var.lane_number]
    if sensors.gpIn[global.AFC_trigger_input_numbers[var.unit_number][var.lane_number]].value == 1
        if move.motionSystems[0].currentTool >= 0 && global.AFC_tool_map[move.motionSystems[0].currentTool][0] == var.unit_number && global.AFC_tool_map[move.motionSystems[0].currentTool][1] == var.lane_number
            continue
        M98 P"0:/sys/AFC/Macros/triggers.g" A{var.tool_number}
        set var.parked = var.parked + 1
M291 P{var.parked ^ " lane(s) parked."} R"Lane - Park" S1 T3
