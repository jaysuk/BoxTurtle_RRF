; ==========================================================================================
; AFC Lane Length Report (List View)
; Uses a selection menu to display the data as a clean vertical list.
; ==========================================================================================
var lane_number = 0
var unit_number = 0
var lane_info = ""

if #global.M291_data[0] != 1
    M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
    set var.unit_number = input
else
    set var.unit_number = 0

; 1. Create a temporary array to hold the text strings
; We set the size of the vector to match the total number of lanes.
var report_list = global.M291_data[1][var.unit_number]

; 2. Populate the array
while iterations < #var.report_list
    ; Create the string for this specific lane
    if global.AFC_lanes[var.unit_number][iterations][1] == 0
        set var.lane_info = var.report_list[iterations] ^ " has not been calibrated"
    else
        set var.lane_info = var.report_list[iterations] ^ ": " ^ global.AFC_lanes[var.unit_number][iterations][1] ^ "mm"
    
    ; Add "(Empty/Uncalibrated)" text if the length is 0 for clarity
    
         
    ; Store it in the list
    set var.report_list[iterations] = var.lane_info

; 3. Display the List
; P = Title
; K = The array of strings we just created
; S4 = Selection Mode (creates the list buttons)
; F0 = No "Cancel" button, forcing the user to click a lane (button) to close the window.
M291 P{"Unit " ^ var.unit_number ^ " Current Lane Lengths (Click any to close)"} K{var.report_list} S4 F0