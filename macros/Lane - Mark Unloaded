; ==========================================================================================
; Mark Lane as Empty / Unloaded
; Manually resets the status flag of a lane to "False" and updates LEDs/Persistence.
; ==========================================================================================

var lane_number = 0
var tool_number = 0
var unit_number = 0
var manual_trigger = false ; Track if this was triggered by a human or a button/script
var msg_time = 3

; --- Input Logic ---
if exists(param.A)
    set var.tool_number = param.A                                              ; Assign parameter to local variable for cleaner syntax
    set var.unit_number = global.Tool_to_AFC[var.tool_number][0]
    set var.lane_number = global.Tool_to_AFC[var.tool_number][1]
    set var.manual_trigger = false
else
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
        set var.unit_number = input
    else
        set var.unit_number = 0
    
    M291 P"Select the lane to mark as Empty" K{global.M291_data[1][var.unit_number]} S4 J1
    set var.lane_number = input
    set var.manual_trigger = true

; --- Status Check & Execution ---
if global.AFC_lanes[var.unit_number][var.lane_number][0]
    
    ; Safety Check: Only ask for confirmation if manually triggered (S3 = OK/Cancel)
    if var.manual_trigger
        M291 P{"Mark Unit " ^ var.unit_number ^ ": Lane " ^ var.lane_number ^ " as Empty? This resets the status."} R"Confirm Reset" S3
    
    ; Update Global Variable
    set global.AFC_lanes[var.unit_number][var.lane_number][0] = false
    
    ; Automatically Unassign any Spool linked to this lane
    M98 P"0:/macros/Spool - Unassign" A{var.unit_number} B{var.lane_number}
    
    ; Update LEDs (Set to Red/Empty)
    set global.AFC_LED_array[var.unit_number][var.lane_number] = 0
    M98 P"0:/sys/AFC/Macros/leds.g"
    M400
    M98 P"0:/sys/AFC/Macros/save_status.g"

    ; Success Message (S1 T3 = Green toast message for 3 seconds)
    M291 P{"Unit " ^ var.unit_number ^ ": Lane " ^ var.lane_number ^ " is now marked as Empty."} R"Success" S1 T{var.msg_time}

else
    ; Error/Info Message (S2 = Red/Warning tone)
    ; Changed from M118 (Console) to M291 (Popup) so the user definitely sees it.
    M291 P{"Unit " ^ var.unit_number ^ ": Lane " ^ var.lane_number ^ " is already marked as Empty."} R"Notice" S2 T{var.msg_time}