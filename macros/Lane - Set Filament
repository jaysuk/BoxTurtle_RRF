; ==========================================================================================
; Lane - Set Filament
; Describes the filament in a lane without a spool record: type, colour name, colour hex ("#RRGGBB") and print temperature.
; The LED shows the hex colour when the lane is ready; the temperature is used when the lane is loaded (0 = default 220 C).
; param.A tool number of the lane (optional, otherwise unit and lane are asked)
; ==========================================================================================

var unit_number = 0
var lane_number = 0
var type = ""
var colour = ""
var hex = ""
var temp = 0

if exists(param.A)
    set var.unit_number = global.Tool_to_AFC[param.A][0]
    set var.lane_number = global.Tool_to_AFC[param.A][1]
else
    if #global.M291_data[0] != 1
        M291 P"Select the Unit" K{global.M291_data[0]} S4 J2
        if result == -1
            M99
        set var.unit_number = input
    M291 P"Select the lane" K{global.M291_data[1][var.unit_number]} S4 J2
    if result == -1
        M99
    set var.lane_number = input

M291 P"Filament type (e.g. PLA, PETG, ABS)" R"Lane - Set Filament" S7 J2
if result == -1
    M99
set var.type = input
M291 P"Colour name (e.g. Red)" R"Lane - Set Filament" S7 J2
if result == -1
    M99
set var.colour = input
M291 P"Colour as #RRGGBB for the LED (empty = default green)" R"Lane - Set Filament" S7 J2
if result == -1
    M99
set var.hex = input
if find(var.type, """") != -1 || find(var.colour, """") != -1 || find(var.hex, """") != -1
    M291 P"Double quotes are not allowed in the text fields." R"Lane - Set Filament" S2
    M99
if var.hex != ""
    M98 P"0:/sys/AFC/Macros/hex_to_rgb.g" A{var.hex}
    if global.AFC_rgb[0] < 0
        M291 P"That is not a #RRGGBB colour (for example #FF8000). Nothing was changed." R"Lane - Set Filament" S2
        M99
M291 P"Print temperature in C (0 = default 220)" R"Lane - Set Filament" S5 J2
if result == -1
    M99
set var.temp = input

set global.AFC_lanes[var.unit_number][var.lane_number][4] = [var.type, var.colour]
set global.AFC_lane_hex[var.unit_number][var.lane_number] = var.hex
set global.AFC_extruder_temp[var.unit_number][var.lane_number] = var.temp
M98 P"0:/sys/AFC/Macros/leds.g"
M98 P"0:/sys/AFC/Macros/save_status.g"
M291 P{"Unit "^var.unit_number^" Lane "^var.lane_number^": "^var.type^" "^var.colour} R"Lane - Set Filament" S1 T3
