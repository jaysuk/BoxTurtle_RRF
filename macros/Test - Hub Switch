; ==========================================================================================
; AFC Hub Switch Diagnostic Tool
; guides the user to manually trigger/untrigger the switch to verify functionality.
; ==========================================================================================
var lane_number = 0
var tool_number = 0
var unit_number = 0

M291 P"This test is best carried out from the rear of the hub, with the PTFE removed, using a piece of filament, inserted when instructed" R"Preparation" S3

if #global.M291_data[0] != 1
    M291 P"Select the Unit" K{global.M291_data[0]} S4 J1
    set var.unit_number = input
else
    set var.unit_number = 0

; --- 1. Configuration ---
; Configure the hub switch as a general input sensor (J) using the pin defined in globals.
; We configure it now so we can read the state 'sensors.gpIn[...].value' below.
M950 J{global.AFC_hub_input_numbers[var.unit_number]} C{global.AFC_hub_switch[var.unit_number]} 

; --- 2. Test "Empty" State ---
; Prompt user to remove filament. Script pauses here until user clicks "OK".
M291 P{"Please ensure there is no filament in the Hub of Unit "^var.unit_number^" to test the 'Empty' state."} R"Hub Switch Test (1/2)" S3

; Check the sensor value. 
; Assuming: 0 = Open/Empty, 1 = Triggered/Full. 
; (If your logic is inverted, swap the 0 and 1 in the checks below).
if sensors.gpIn[global.AFC_hub_input_numbers[var.unit_number]].value != 0
    ; FAIL STATE: User said it's empty, but sensor reads 1 (Present)
    M291 P{"Test Failed: The hub switch of Unit "^var.unit_number^" still reads 'Filament Present' when empty. Check wiring or obstructions."} R"Failure" S2
    M950 J{global.AFC_hub_input_numbers[var.unit_number]} C"nil" ; Free the pin
    M291 P{"Aborting macro. Line "^line} R"0:/macros/Test - Hub Switch" S1
    abort ; Exit the macro immediately
else
    M291 P{"Test Passed"} R"Success" S1 T3

G4 S1

; --- 3. Test "Present" State ---
; Prompt user to insert filament. Script pauses here until user clicks "OK".
M291 P{"Please INSERT filament into the Hub of Unit "^var.unit_number^" to test the 'Detected' state."} R"Hub Switch Test (2/2)" S3

if sensors.gpIn[global.AFC_hub_input_numbers[var.unit_number]].value == 0
    ; FAIL STATE: User inserted filament, but sensor reads 0 (Empty)
    M291 P{"Test Failed: The hub switch  of Unit "^var.unit_number^" reads 'Empty' while filament is inserted. Check wiring or switch positioning."} R"Failure" S2
    M950 J{global.AFC_hub_input_numbers[var.unit_number]} C"nil" ; Free the pin
    M291 P{"Aborting macro. Line "^line} R"0:/macros/Test - Hub Switch" S1
    abort ; Exit the macro immediately
else
    M291 P{"Test Passed"} R"Success" S1 T3

G4 S1

; --- 4. Success & Cleanup ---
; If the script reaches this line, both tests passed.
M291 P{"Success! The Hub Switch of Unit "^var.unit_number^" correctly detected both states."} R"Test Passed" S1 T5

; Release/Free the physical pin and input index so they can be used by other macros/system
M950 J{global.AFC_hub_input_numbers[var.unit_number]} C"nil"